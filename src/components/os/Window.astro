---
const { id, title, state = "READY" } = Astro.props;
---

<section class="os-window" data-window={id} role="dialog" aria-modal="false" aria-labelledby={`${id}-title`} hidden>
  <header class="window-bar">
    <div><span class="window-dot"></span><strong id={`${id}-title`}>{title}</strong><small>{state}</small></div>
    <div class="window-controls">
      <button type="button" data-window-minimize={id} aria-label={`Minimize ${title}`}>−</button>
      <button type="button" data-window-maximize={id} aria-label={`Maximize ${title}`}>□</button>
      <button type="button" data-window-close={id} aria-label={`Close ${title}`}>×</button>
    </div>
  </header>
  <div class="window-body"><slot /></div>
</section>

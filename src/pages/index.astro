---
import "../styles/global.css";
import AppIcon from "../components/os/AppIcon.astro";
import Window from "../components/os/Window.astro";
import { faqs, projects } from "../data/portfolio";
import { ownerProfile } from "../data/owner-profile";

const site = `https://${ownerProfile.identity.domain}`;
const title = "Anuj Patel (@byanujpatel) — Applied AI & Voice AI Engineer";
const description = "Anuj Patel is an Applied AI and Voice AI engineer building realtime voice agents, LLM products, RAG systems, memory, and FastAPI backends for founders and teams.";
const keywords = "Anuj Patel, byanujpatel, voice AI engineer, AI voice agent developer, LiveKit developer, Sarvam AI developer, applied AI engineer, RAG memory systems, FastAPI developer, AI MVP freelancer";
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${site}/#person`,
      name: ownerProfile.identity.fullName,
      alternateName: "byanujpatel",
      url: `${site}/`,
      email: `mailto:${ownerProfile.conversion.email}`,
      jobTitle: "Applied AI & Voice AI Engineer",
      description,
      address: { "@type": "PostalAddress", addressCountry: "IN" },
      knowsAbout: ["Voice AI", "LiveKit", "Sarvam AI", "Conversational AI", "LLMs", "RAG", "Memory systems", "FastAPI", "Python", "AI MVP development"],
      sameAs: ownerProfile.socials.map((social) => social.href),
    },
    { "@type": "WebSite", "@id": `${site}/#website`, url: `${site}/`, name: "Anuj OS", publisher: { "@id": `${site}/#person` }, inLanguage: "en" },
    {
      "@type": "FAQPage",
      "@id": `${site}/#faq`,
      mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.q, acceptedAnswer: { "@type": "Answer", text: faq.a } })),
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={ownerProfile.identity.fullName} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <meta name="google-site-verification" content="l4kqyExiNKJyqOllK04zRTyC_zlqxPWtiZ96hEyyD9Q" />
    <link rel="canonical" href={`${site}/`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:type" content="profile" />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${site}/og-image.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og-image.png`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6511116190748300" crossorigin="anonymous" is:inline></script>
  </head>
  <body class="os-body">
    <main class="os-shell">
      <header class="os-nav">
        <a class="os-brand" href="/" aria-label="Anuj OS home"><span class="os-brand-mark">AP</span><span>{ownerProfile.identity.osName}</span></a>
        <nav class="os-nav-links" aria-label="System navigation">
          <button type="button" data-open-app="projects">Work</button>
          <button type="button" data-open-app="proof">Proof</button>
          <button type="button" data-open-app="contact">Contact</button>
          <button type="button" data-open-search>Search</button>
        </nav>
        <div class="os-status"><span class="status-dot"></span><span>Available</span><span class="os-clock" data-clock>--:-- IST</span><button type="button" data-theme="dark" aria-label="Toggle dark mode">◐</button></div>
      </header>

      <section class="os-desktop" aria-label="Anuj OS desktop">
        <div class="os-identity">
          <p class="os-kicker">{ownerProfile.identity.roles.join(" · ")}</p>
          <h1>{ownerProfile.identity.headline}</h1>
          <p class="os-intro">{ownerProfile.identity.intro}</p>
          <div class="os-actions"><a class="os-primary" href={ownerProfile.conversion.primaryUrl} target="_blank" rel="noreferrer">{ownerProfile.conversion.primaryLabel} ↗</a><button class="os-secondary" type="button" data-open-app="projects">Enter the portfolio</button></div>
          <div class="os-proof-line"><span>VOICE AI</span><span>LLM + RAG</span><span>BACKEND SYSTEMS</span><span>AI MVPs</span></div>
        </div>

        <div class="os-app-grid" aria-label="Portfolio applications">
          {ownerProfile.apps.map((app) => <AppIcon app={app} />)}
        </div>

        <aside class="os-transmission" aria-label="Daily transmission">
          <div><span class="os-kicker">Daily transmission</span><span class="os-live">● LIVE</span></div>
          <strong>Build the sharp edge. Prove it with a working loop.</strong>
          <button type="button" data-open-app="whiteboard">+ Add a quick sticky</button>
        </aside>

        <div class="os-wall-note"><span>Now exploring</span><strong>Voice · context · memory</strong><small>Systems that listen, remember, and act.</small></div>
      </section>

      <div class="os-dock" aria-label="Application dock">
        {ownerProfile.apps.slice(0, 6).map((app) => <button type="button" data-open-app={app.id} aria-label={`Open ${app.label}`}><span>{app.id === "voice" ? "◉" : app.id === "projects" ? "▣" : app.id === "contact" ? "@" : app.id === "proof" ? "◆" : app.id === "systems" ? "⚙" : "✎"}</span><small>{app.label}</small></button>)}
      </div>

      <div class="os-call-tab"><span>Want this for your business?</span><a href={ownerProfile.conversion.bookingUrl} target="_blank" rel="noreferrer">Book an intro call ↗</a></div>

      <div class="os-window-layer" aria-live="polite">
        <Window id="projects" title="Projects / Main Drive" state="4 BUILDS">
          <p class="window-lead">Selected work across voice AI, memory, LLM workflows, and backend systems.</p>
          <div class="os-project-list">{projects.map((project) => <article class="os-project"><div><span>{project.type}</span><strong>{project.signal}</strong></div><h3>{project.name}</h3><p>{project.solution}</p><div class="os-tags">{project.stack.map((tool) => <small>{tool}</small>)}</div><div class="os-project-links">{project.name === "VANI" && <a href="/projects/vani/">Case file →</a>}{project.name === "Smriti" && <a href="/projects/smriti/">Case file →</a>}{project.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} ↗</a>)}</div></article>)}</div>
        </Window>

        <Window id="voice" title="AI Voice Agent" state="DEMO MODE">
          <div class="voice-app"><div class="voice-orb">◉</div><p class="window-lead">Talk to the AI Voice Agent</p><p>This is the next interface layer: realtime voice, context, and memory. Try the working Smriti voice companion while the portfolio agent is in text fallback mode.</p><a class="os-primary" href={ownerProfile.conversion.primaryUrl} target="_blank" rel="noreferrer">Open Smriti Live ↗</a><small>Voice sessions require microphone permission. No audio is stored by this portfolio.</small></div>
        </Window>

        <Window id="systems" title="Systems / How I Build" state="METHOD">
          <div class="systems-list">{["Find the leverage", "Lock the system", "Build the sharp edge", "Integrate the workflow", "Prove and hand off"].map((step, index) => <article><b>0{index + 1}</b><div><h3>{step}</h3><p>{["Clarify the user, bottleneck, and smallest valuable loop.", "Choose the data, model, API, and interface boundaries.", "Build a focused prototype around the highest-signal behavior.", "Connect the product to real tools, memory, and operational context.", "Test with users, document the system, and make ownership clear."][index]}</p></div></article>)}</div>
        </Window>

        <Window id="proof" title="Proof / Signal Vault" state="LINKS">
          <p class="window-lead">Proof should be something a visitor can open, use, or inspect.</p><div class="proof-links"><a href="/projects/vani/">VANI — Sarvam AI voice agent <span>Case file ↗</span></a><a href="/projects/smriti/">Smriti — voice health memory <span>Live + case file ↗</span></a><a href="https://x.com/byanujpatel/status/2089730103928598667" target="_blank" rel="noreferrer">VANI demo video on X <span>Watch ↗</span></a></div>
        </Window>

        <Window id="founder" title="Founder.txt" state="NOTE">
          <div class="founder-note"><p><b>Who I am:</b> Anuj Patel — applied AI, Voice AI, and backend engineer.</p><p><b>What I build:</b> Voice agents, LLM products, RAG and memory systems, and full-stack MVPs.</p><p><b>How I work:</b> Small loop first. Real user early. Clear handoff always.</p><p><b>Currently exploring:</b> LiveKit, voice models, context intelligence, and useful memory.</p><p><b>Who I want to work with:</b> Founders and businesses with a real workflow worth improving.</p></div>
        </Window>

        <Window id="contact" title="Contact / Start a Build" state="OPEN">
          <p class="window-lead">Have a workflow that should listen, remember, or act?</p><div class="contact-actions"><a class="os-primary" href={ownerProfile.conversion.bookingUrl} target="_blank" rel="noreferrer">Book an intro call ↗</a><a class="os-secondary" href={`mailto:${ownerProfile.conversion.email}`}>Email Anuj</a></div><div class="service-list">{ownerProfile.services.map((service) => <article><h3>{service.name}</h3><p>{service.text}</p></article>)}</div>
        </Window>

        <Window id="browser" title="Browser / Approved Links" state="WEB">
          <p class="window-lead">Open verified project links in a new tab.</p><div class="proof-links"><a href="https://smriti-health-companion.onrender.com/" target="_blank" rel="noreferrer">Smriti live app <span>Open ↗</span></a><a href="https://repurposemycontent.streamlit.app" target="_blank" rel="noreferrer">Content Repurposing Engine <span>Open ↗</span></a><a href="https://crypto-trend-finder.streamlit.app" target="_blank" rel="noreferrer">TrendChain AI <span>Open ↗</span></a></div>
        </Window>

        <Window id="whiteboard" title="Whiteboard / Local Only" state="LOCAL">
          <p class="window-lead">Leave a note for yourself. It stays in this browser only.</p><form class="sticky-form" data-sticky-form><input name="note" maxlength="180" placeholder="What should this portfolio remember?" aria-label="Sticky note text" required /><button type="submit">Add</button></form><div class="sticky-board" data-sticky-board></div><button class="os-secondary" type="button" data-clear-stickies>Clear board</button>
        </Window>
      </div>
    </main>

    <div class="os-search" data-search-panel hidden><div class="search-box"><input data-search-input placeholder="Search apps and projects..." aria-label="Search portfolio" /><button type="button" data-close-search>×</button><div data-search-results></div></div></div>

    <script>
      type Note = { id: string; text: string };
      const root = document.documentElement;
      const windows = document.querySelectorAll<HTMLElement>("[data-window]");
      const openWindow = (id: string | undefined) => {
        if (!id) return;
        windows.forEach((win) => { win.hidden = win.dataset.window !== id; });
      };
      const closeWindows = () => windows.forEach((win) => { win.hidden = true; });
      document.querySelectorAll<HTMLElement>("[data-open-app]").forEach((button) => button.addEventListener("click", () => openWindow(button.dataset.openApp)));
      document.querySelectorAll("[data-window-close], [data-window-minimize]").forEach((button) => button.addEventListener("click", closeWindows));
      document.querySelectorAll("[data-window-maximize]").forEach((button) => button.addEventListener("click", () => button.closest<HTMLElement>("[data-window]")?.classList.toggle("is-maximized")));
      document.querySelector<HTMLButtonElement>("[data-theme]")?.addEventListener("click", () => root.classList.toggle("os-dark"));

      const clock = document.querySelector<HTMLElement>("[data-clock]");
      const tick = () => { if (clock) clock.textContent = `${new Intl.DateTimeFormat("en-IN", { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "Asia/Kolkata" }).format(new Date())} IST`; };
      tick();
      setInterval(tick, 30000);

      const searchPanel = document.querySelector<HTMLElement>("[data-search-panel]");
      const searchInput = document.querySelector<HTMLInputElement>("[data-search-input]");
      const searchResults = document.querySelector<HTMLElement>("[data-search-results]");
      const searchItems = [...document.querySelectorAll<HTMLElement>("[data-open-app]")]
        .map((item) => ({ id: item.dataset.openApp, label: item.getAttribute("aria-label") || item.textContent?.trim() || "" }))
        .filter((item, index, all) => all.findIndex((candidate) => candidate.id === item.id) === index);
      const renderSearch = () => {
        if (!searchInput || !searchResults) return;
        const query = searchInput.value.toLowerCase();
        searchResults.innerHTML = searchItems
          .filter((item) => item.label.toLowerCase().includes(query))
          .map((item) => `<button type="button" data-search-app="${item.id}">${item.label}</button>`)
          .join("");
        searchResults.querySelectorAll<HTMLButtonElement>("[data-search-app]").forEach((item) => item.addEventListener("click", () => { if (searchPanel) searchPanel.hidden = true; openWindow(item.dataset.searchApp); }));
      };
      document.querySelector("[data-open-search]")?.addEventListener("click", () => { if (searchPanel) searchPanel.hidden = false; searchInput?.focus(); renderSearch(); });
      document.querySelector("[data-close-search]")?.addEventListener("click", () => { if (searchPanel) searchPanel.hidden = true; });
      searchInput?.addEventListener("input", renderSearch);
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") { if (searchPanel) searchPanel.hidden = true; closeWindows(); }
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") { event.preventDefault(); if (searchPanel) searchPanel.hidden = false; searchInput?.focus(); renderSearch(); }
      });

      const board = document.querySelector<HTMLElement>("[data-sticky-board]");
      const stickyForm = document.querySelector<HTMLFormElement>("[data-sticky-form]");
      const key = "personal-os-whiteboard-v1";
      let notes: Note[] = [];
      try { notes = JSON.parse(localStorage.getItem(key) || "[]") as Note[]; } catch { notes = []; }
      const escapeHtml = (value: string) => value.replace(/[&<>]/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" })[char] || char);
      const drawNotes = () => {
        if (!board) return;
        board.innerHTML = notes.map((note) => `<article class="sticky-note"><button type="button" data-delete-note="${note.id}" aria-label="Delete note">×</button><p>${escapeHtml(note.text)}</p></article>`).join("");
        board.querySelectorAll<HTMLButtonElement>("[data-delete-note]").forEach((button) => button.addEventListener("click", () => { notes = notes.filter((note) => note.id !== button.dataset.deleteNote); localStorage.setItem(key, JSON.stringify(notes)); drawNotes(); }));
      };
      drawNotes();
      stickyForm?.addEventListener("submit", (event) => {
        event.preventDefault();
        const input = stickyForm.querySelector<HTMLInputElement>("input");
        if (input?.value.trim()) { notes.push({ id: crypto.randomUUID(), text: input.value.trim() }); localStorage.setItem(key, JSON.stringify(notes)); input.value = ""; drawNotes(); }
      });
      document.querySelector("[data-clear-stickies]")?.addEventListener("click", () => { notes = []; localStorage.removeItem(key); drawNotes(); });
    </script>
  </body>
</html>
